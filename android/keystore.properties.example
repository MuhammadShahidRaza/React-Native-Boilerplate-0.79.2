# Copy this file to android/keystore.properties (which is gitignored) and fill in
# real values. Never commit android/keystore.properties or the .keystore file itself.
#
# To generate a fresh, project-specific release keystore:
#   keytool -genkeypair -v -keystore android/app/release.keystore \
#     -alias <yourapp>-release -keyalg RSA -keysize 2048 -validity 10000
#
# Store the resulting passwords in your password manager / CI secrets — losing this
# keystore means you can never publish an update to an already-released app.

storeFile=app/release.keystore
storePassword=CHANGE_ME
keyAlias=CHANGE_ME
keyPassword=CHANGE_ME
